{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["konnect"],
  "permissions": {
    "allow": [
      "Bash(kicad-cli version)",
      "Bash(kicad-cli sch export *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Edit(./*.kicad_sch)",
      "Edit(./**/*.kicad_sch)",
      "Edit(./*.kicad_pcb)",
      "Edit(./**/*.kicad_pcb)",
      "Edit(./*.kicad_pro)",
      "Edit(./**/*.kicad_pro)",
      "Edit(./*.kicad_prl)",
      "Edit(./**/*.kicad_prl)",
      "Edit(./*.kicad_sym)",
      "Edit(./**/*.kicad_sym)",
      "Edit(./*.kicad_mod)",
      "Edit(./**/*.kicad_mod)",
      "Edit(./sym-lib-table)",
      "Edit(./**/sym-lib-table)",
      "Edit(./fp-lib-table)",
      "Edit(./**/fp-lib-table)"
    ]
  }
}
